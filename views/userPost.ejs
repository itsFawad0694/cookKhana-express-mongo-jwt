<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CookKhana!</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="shortcut icon" href="/image/fav.png" type="image/x-icon">
  </head>
  <body>
    <nav>
      <div class="logo">
        <img src="/image/logo.png" alt="logo" class="logoIcon">
        <h1>CookKhana</h1>
      </div>
      <ul>
        <li><a href="/">Home</a></li>|
        <li><a href="/recipe">Add Recipe</a></li>|
        <form action="/logout" method="POST">
          <button type="submit" class="logoutbtn">Logout</button>
        </form>
      </ul>
    </nav>
    <div class="container">
      <div class="box">
        <% if (recipes.length > 0) { %> <% recipes.forEach(item => { %>

        <div class="card">
          <img
                  src="/uploads/<%= item.image %>"
                  alt="Recipe Image"
                  style="width:200px;border-radius:10px;">
          <h2><%= item.title %></h2>
          <h4><%= item.cookingTime %> Mins</h2>
          <h4>Difficulty: <%= item.difficulty %></h2>
          <h4>Category: <%= item.category %></h2>

          <div id="displaysteps"><%- item.detail %></div>
          <div id="usercardbtn">
          <form action="/postDelete/<%= item._id %>" method="POST">
            <button type="submit" class="allbtn">Delete</button>
          </form>
          <a href="/updatePost/<%= item._id %>" class="allbtn">Update</a>
        </div>
        </div>

        <% }) %> <% } else { %>

        <h2><%= error %></h2>

        <% } %>
      </div>
    </div>
  </body>
</html>
